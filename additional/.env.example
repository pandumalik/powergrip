# ==============================================================================
# V-CAMS Root Environment Variables
# ==============================================================================

# PostgreSQL 17 Configuration
POSTGRES_DB=vcams_db
POSTGRES_USER=vcams_user
POSTGRES_PASSWORD=vcams_secure_password_2026
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vcams_user:vcams_secure_password_2026@localhost:5432/vcams_db

# Keycloak 26 Configuration
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_password_2026
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=vcams-realm
KEYCLOAK_CLIENT_ID=vcams-backend

# HashiCorp Vault Configuration
VAULT_PORT=8200
VAULT_ADDR=http://localhost:8200
VAULT_ROOT_TOKEN=root_dev_token_vcams_2026

# Redis 7 Configuration
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_2026
REDIS_HOST=localhost

# MinIO S3 Object Storage Configuration
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_2026
MINIO_BUCKET_NAME=vcams-contracts

# NATS JetStream Event Broker
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# Backend Application Configuration
PORT=4000
NODE_ENV=development
