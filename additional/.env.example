# ==============================================================================
# PowerGrip Infrastructure Stack Environment Configuration
# ==============================================================================

# PostgreSQL 17 Primary Database
POSTGRES_PORT=5432
POSTGRES_DB=powergrip_db
POSTGRES_USER=powergrip_user
POSTGRES_PASSWORD=powergrip_secure_password_2026

DATABASE_URL=postgresql://powergrip_user:powergrip_secure_password_2026@localhost:5432/powergrip_db

# Keycloak 26 Identity & Access Management (OIDC & MFA)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_password_2026
KEYCLOAK_REALM=powergrip-realm
KEYCLOAK_CLIENT_ID=powergrip-backend

# HashiCorp Vault (SSH CA & Dynamic Secrets Engine)
VAULT_PORT=8200
VAULT_ROOT_TOKEN=root_dev_token_powergrip_2026
VAULT_ADDR=http://localhost:8200

# Redis 7 (Cache, Distributed Locks & BullMQ Schedulers)
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_2026
REDIS_HOST=localhost

# MinIO S3 Object Storage (Contract PDFs, SLAs, Audit Evidence)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_2026
MINIO_BUCKET_NAME=powergrip-contracts

# NATS JetStream (Asynchronous Event Mesh)
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222
